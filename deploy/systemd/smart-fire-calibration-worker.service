[Unit]
Description=Smart Fire Manager Calibration Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=fire
Group=fire

WorkingDirectory=/opt/smart-fire-detection-v2

EnvironmentFile=/etc/smart-fire-detection/production.env
Environment=PYTHONPATH=/opt/smart-fire-detection-v2
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/smart-fire-detection-v2/venv/bin/python -m manager.calibration_worker

Restart=on-failure
RestartSec=2

RuntimeDirectory=smart-fire-calibration-worker
RuntimeDirectoryMode=0770

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

ReadWritePaths=/opt/smart-fire-detection-v2/manager/static/calibration_sessions

RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
